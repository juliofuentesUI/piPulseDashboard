# Copy to .env and adjust. Every value has a working default, so .env is optional.
#
# The API reads this file through Node's --env-file-if-exists, wired into the
# dev and start scripts in apps/api/package.json. Before that flag existed the
# file reached Vite and nothing else, so every API setting here silently ran on
# its default — worth knowing if you are reading an older checkout.
#
# .env is gitignored and stays that way. On the Pi it is written once, by
# ./scripts/pi-setup.sh, and survives every git pull afterwards for the same
# reason apps/api/data/ does: git does not manage it.

# --- Fastify API ---
PORT=3000
HOST=0.0.0.0

# --- Location (defaults to San Jose, California) ---
WEATHER_LOCATION_NAME=San Jose
WEATHER_LATITUDE=37.3382
WEATHER_LONGITUDE=-121.8863
WEATHER_TIMEZONE=America/Los_Angeles

# --- Upstream weather source ---
# Open-Meteo needs no API key.
WEATHER_CACHE_TTL_MS=300000
WEATHER_REQUEST_TIMEOUT_MS=8000

# --- Search Pulse (Google Trending Now) ---
# The official RSS export needs no API key and no account.
# TRENDS_REGION is a Google geo code: US, GB, DE, ...
# The 10-minute cache is what keeps an unauthenticated, IP-rate-limited feed
# happy while the screen polls this service every 60 seconds.
TRENDS_REGION=US
TRENDS_CACHE_TTL_MS=600000
TRENDS_REQUEST_TIMEOUT_MS=8000

# --- Trend categories (OpenAI) ---
# The one secret this project has. Never commit it: put it in .env, which is
# gitignored, and nowhere else. A leaked key is rotated at platform.openai.com
# and replaced here — no commit, no push, no history to purge.
#
# Its absence is the off switch. With no key the dashboard runs exactly as it
# does today: no calls, no cost, no category badges, everything else unchanged.
# A service account key scoped to its own project, with a spending limit set,
# is what belongs here — see docs/trend-category-plan.md.
OPENAI_API_KEY=

# --- Vite dev server ---
# Port the Svelte dev server listens on; it proxies /api to PORT above.
WEB_PORT=5173

# --- Events map (SerpApi + MapTiler) ---
# Which source feeds the events page. `mock` (the default) serves fabricated
# events from apps/api/src/events-mock.ts and costs nothing; `serpapi` uses the
# real Google Events engine.
#
# It defaults to mock deliberately. SerpApi's Google Events engine has returned
# zero results for every query since 2026-08-04 (serpapi/public-roadmap#4117),
# and an empty response bills exactly like a full one — so a default of
# `serpapi` would spend a 250-a-month quota to receive nothing.
#
# THE SCREEN MUST SAY WHEN THIS IS `mock`. The API carries the answer as
# EventsSnapshot.source for exactly that reason.
EVENTS_PROVIDER=mock

# Backend only. Never commit it, never log it, never send it to the browser.
SERPAPI_KEY=

# MapTiler, twice, on purpose. The tile key reaches the browser because the
# browser fetches tiles directly; the geocoding key is only ever used from the
# API. They hold the same value today — splitting them means origin-restricting
# the tile key later is a config change rather than a refactor.
MAPTILER_KEY=
VITE_MAPTILER_KEY=

# How far out an event may be and still appear on the page.
EVENTS_RADIUS_MILES=20

# How far out a *geocoding result* may land before it is treated as nonsense
# rather than as a distant venue. Deliberately not the same number as the radius
# above: this one asks "is this result garbage?", the radius asks "is this near
# enough to show?". Sharing one value made a real venue 25 miles away
# indistinguishable from an address nobody could place.
EVENTS_GEOCODE_SANITY_MILES=150

# Once a day. Seven queries daily is ~217 searches against a 250 free tier;
# three-hourly would be 1,680 and past the paid plan too. Nothing drives this on
# a timer — it refreshes on the first request after the TTL, so a Pi that is
# switched off spends no quota.
EVENTS_CACHE_TTL_MS=86400000
EVENTS_REQUEST_TIMEOUT_MS=15000
EVENTS_GEOCODE_TIMEOUT_MS=8000

# The permanent address-to-coordinate cache. A venue does not move, so every
# address is geocoded once, ever. Measured: 11 lookups on a cold start, 0 once
# warm. Gitignored like the trend history, for the same reason.
EVENTS_DB_PATH=data/events.db

# SerpApi's `location` parameter. Not the same thing as the map centre, which
# comes from WEATHER_LATITUDE / WEATHER_LONGITUDE above.
EVENTS_SEARCH_LOCATION=San Jose, California, United States

# The searches, `|`-separated. Unset uses the seven built into config.ts. They
# overlap on purpose; deduplication merges what they share.
# EVENTS_QUERIES=events near San Jose CA|free community events near San Jose CA
